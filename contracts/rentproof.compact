pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger threshold: Uint<64>;
export ledger verified: Boolean;

witness getBalance(): Uint<64>;

export circuit setThreshold(t: Uint<64>): [] {
    threshold = disclose(t);
}

export circuit proveSolvency(): [] {
    const balance = getBalance();
    verified = disclose(balance >= threshold);
}
